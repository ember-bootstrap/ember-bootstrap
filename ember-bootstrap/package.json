      "./components/bs-form/element/layout/inline.js": "./dist/_app_/components/bs-form/element/layout/inline.js",
      "./components/bs-form/element/layout/inline/checkbox.js": "./dist/_app_/components/bs-form/element/layout/inline/checkbox.js",
