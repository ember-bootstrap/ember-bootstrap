{
  "name": "ember-bootstrap",
  "version": "6.6.1",
  "description": "Bootstrap components for Ember.js",
  "keywords": [
    "ember-addon",
    "bootstrap"
  ],
  "homepage": "https://www.ember-bootstrap.com/",
  "bugs": {
    "url": "https://github.com/ember-bootstrap/ember-bootstrap/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-bootstrap/ember-bootstrap"
  },
  "license": "MIT",
  "author": "Simon Ihmig <ihmig@kaliber5.de>",
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*",
        "declarations/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "release": "pnpm exec release-it"
  },
  "dependencies": {
    "@ember/render-modifiers": "^3.0.0",
    "@embroider/addon-shim": "^1.8.9",
    "@embroider/macros": "^1.0.0",
    "@embroider/util": "^1.0.0",
    "broccoli-debug": "^0.6.3",
    "chalk": "^5.0.0",
    "decorator-transforms": "^2.2.2",
    "ember-auto-import": "^2.6.3",
    "ember-cli-babel": "^8.0.0",
    "ember-cli-build-config-editor": "^0.5.1",
    "ember-cli-htmlbars": "^7.0.0",
    "ember-concurrency": "^4.0.0",
    "ember-element-helper": "^0.8.0",
    "ember-focus-trap": "^2.0.0",
    "ember-on-helper": "^0.1.0",
    "ember-popper-modifier": "^4.0.0",
    "ember-render-helpers": "^2.0.0",
    "ember-style-modifier": "^4.0.0",
    "ember-template-imports": "^4.4.0",
    "findup-sync": "^5.0.0",
    "tracked-toolbox": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@ember/library-tsconfig": "^2.0.0",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.0",
    "@embroider/core": "^4.1.0",
    "@embroider/macros": "^1.20.1",
    "@embroider/vite": "^1.1.5",
    "@glint/ember-tsc": "^1.5.0",
    "@glint/template": "^1.7.7",
    "@glint/tsserver-plugin": "^2.0.0",
    "@popperjs/core": "2.11.8",
    "@release-it-plugins/lerna-changelog": "8.0.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@simple-dom/interface": "1.4.0",
    "@types/rsvp": "4.0.9",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "9.2.1",
    "ember-cli": "6.8.0",
    "ember-cli-build-config-editor": "0.5.1",
    "ember-template-lint": "^7.9.0",
    "ember-template-lint-plugin-prettier": "5.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "12.7.5",
    "eslint-plugin-hbs": "1.0.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-qunit": "8.2.5",
    "focus-trap": "7.6.6",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "publint": "^0.3.16",
    "release-it": "19.0.6",
    "rollup": "^4.22.5",
    "typescript": "5.9.3",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "@glimmer/component": "^1.0.4 || ^2.0.0",
    "ember-modifier": "^3.2.7 || ^4.0.0",
    "ember-source": ">= 5.12.0"
  },
  "engines": {
    "node": "20.* || 22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
