{
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-bootstrap/ember-bootstrap"
  },
  "scripts": {
    "docs:build": "pnpm --filter ember-bootstrap-docs docs:build",
    "prepare": "husky && pnpm build",
    "build": "pnpm --filter ember-bootstrap build",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "test": "concurrently \"npm:test:*\"",
    "test:ember": "pnpm --filter test-app test:ember",
    "release": "pnpm --filter ember-bootstrap release"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "husky": "9.1.7",
    "lint-staged": "16.4.0"
  },
  "volta": {
    "node": "22.23.5"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
