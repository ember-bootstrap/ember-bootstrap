{
  "name": "ember-bootstrap-docs",
  "private": true,
  "scripts": {
    "docs:build": "gulp docs:build",
    "docs:serve": "gulp docs:serve",
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@ember/optional-features": "3.0.0",
    "@ember/test-helpers": "5.4.3",
    "@embroider/macros": "1.21.4",
    "@eslint/js": "9.39.5",
    "@glimmer/component": "2.2.1",
    "@glimmer/tracking": "1.1.2",
    "bootstrap": "5.3.9",
    "broccoli-asset-rev": "3.0.0",
    "concurrently": "10.0.7",
    "ember-auto-import": "2.13.1",
    "ember-basic-dropdown": "9.0.1",
    "ember-bootstrap": "workspace:*",
    "ember-bootstrap-cp-validations": "2.1.0",
    "ember-bootstrap-power-select": "7.0.0",
    "ember-cli": "6.12.0",
    "ember-cli-app-version": "7.0.0",
    "ember-cli-babel": "8.3.2",
    "ember-cli-clean-css": "3.0.0",
    "ember-cli-dependency-checker": "3.3.3",
    "ember-cli-deprecation-workflow": "3.4.0",
    "ember-cli-fastboot": "4.1.5",
    "ember-cli-htmlbars": "7.0.1",
    "ember-cli-inject-live-reload": "2.1.0",
    "ember-cli-sass": "11.0.1",
    "ember-cli-showdown": "9.0.2",
    "ember-cli-sri": "2.1.1",
    "ember-cli-terser": "4.0.2",
    "ember-cli-yuidoc": "0.9.1",
    "ember-code-snippet": "3.0.0",
    "ember-concurrency": "5.3.0",
    "ember-cp-validations": "7.0.0",
    "ember-load-initializers": "3.0.1",
    "ember-modifier": "4.3.0",
    "ember-page-title": "9.1.0",
    "ember-power-select": "8.12.2",
    "ember-prism": "1.0.0",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-sinon-qunit": "7.5.0",
    "ember-source": "6.12.1",
    "ember-template-imports": "4.4.0",
    "ember-template-lint": "7.9.4",
    "ember-template-lint-plugin-prettier": "5.0.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "12.7.5",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-qunit": "8.2.6",
    "execa": "5.1.1",
    "globals": "15.15.0",
    "gulp": "4.0.2",
    "gulp-connect": "5.7.0",
    "gulp-insert": "0.5.0",
    "gulp-rename": "2.1.0",
    "gulp-transform": "3.0.5",
    "loader.js": "4.7.0",
    "merge-stream": "2.0.0",
    "prember": "2.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-ember-template-tag": "2.1.0",
    "qunit": "2.26.0",
    "qunit-dom": "3.6.0",
    "sass": "1.108.2",
    "sinon": "21.1.2",
    "striptags": "3.2.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "16.0.0",
    "tracked-built-ins": "4.1.2",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": "22.* || 24.* || >= 26"
  },
  "ember": {
    "edition": "octane"
  },
  "volta": {
    "extends": "../package.json"
  }
